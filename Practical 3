#include <stdio.h>
struct Item {
int value;
int weight;
};
void fractionalKnapsack(int W, struct Item items[], int n) {
printf("\n***FRACTIONAL KNAPSACK PROBLEM ***\n");
printf("\nKnapsack Capacity = %d\n", W);
printf("\nInput Items:\n");
printf("--------------------------------------------\n");
printf("Item\tValue\tWeight\tProfit/Weight\n");
for(int i=0; i<n; i++)
{
printf("%d\t\t%d\t\t%d\t\t%.2f\n",
i+1,
items[i].value,
items[i].weight,
(double)items[i].value/items[i].weight);
}
/* Bubble Sort based on Profit/Weight ratio */
for (int i = 0; i < n - 1; i++)
{
for (int j = 0; j < n - i - 1; j++)
{
double r1 = (double)items[j].value/items[j].weight;
double r2 = (double)items[j+1].value/items[j+1].weight;
if(r1 < r2)
{
struct Item temp = items[j];
items[j] = items[j+1];
items[j+1] = temp;
}
}
}
printf("\nItems after sorting according to Profit/Weight Ratio:\n");
printf("------------------------------------------------------\n");
printf("Item\tValue\tWeight\tRatio\n");
for(int i=0;i<n;i++)
{
printf("%d\t\t%d\t\t%d\t\t%.2f\n",
i+1,
items[i].value,
items[i].weight,
(double)items[i].value/items[i].weight);
}
int curWeight = 0;
double finalValue = 0.0;
printf("\n******** Filling the Knapsack ********\n");
for(int i=0;i<n;i++)
{
printf("\nConsidering Item %d\n",i+1);
printf("Value = %d\n",items[i].value);
printf("Weight = %d\n",items[i].weight);
if(curWeight + items[i].weight <= W)
{
printf("Entire item can be included.\n");
curWeight += items[i].weight;
finalValue += items[i].value;
printf("Current Weight = %d\n",curWeight);
printf("Current Profit = %.2f\n",finalValue);
}
else
{
int remain = W - curWeight;
printf("Knapsack is almost full.\n");
printf("Remaining Capacity = %d\n",remain);
double fraction = (double)remain/items[i].weight;
printf("Fraction of Item Taken = %.2f\n",fraction);
finalValue += items[i].value * fraction;
curWeight = W;
printf("Weight becomes = %d\n",curWeight);
printf("Profit becomes = %.2f\n",finalValue);
break;
}
}
printf("\n======================================
===\n");
printf("Maximum Value = %.2f\n",finalValue);
printf("Total Weight Used = %d\n",curWeight);
printf("=========================================\n");
}
int main()
{
int W = 50;
struct Item items[] =
{
{60,10},
{100,20},
{120,30}
};
int n = sizeof(items)/sizeof(items[0]);
fractionalKnapsack(W,items,n);
return 0;
}
