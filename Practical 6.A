#include <stdio.h>
#define V 5
#define MAXQ 100
// Function to perform Breadth First Search
void bfs(int adj[V][V], int res[V], int *resSize)
{
int visited[V] = {0};
int q[MAXQ];
int front = 0, rear = 0;
int src = 0; // Starting Vertex
printf("\n=========================================\n");
printf(" BREADTH FIRST SEARCH (BFS)\n");
printf("=========================================\n");
printf("\nSource Vertex = %d\n", src);
visited[src] = 1;
q[rear++] = src;
printf("Vertex %d is marked as VISITED.\n", src);
printf("Vertex %d is inserted into the Queue.\n", src);
while(front < rear)
{
int curr = q[front++];
printf("\n-----------------------------------------\n");
printf("Deleted Vertex %d from Queue.\n", curr);
res[(*resSize)++] = curr;
printf("Current Visited Vertex = %d\n", curr);
printf("Checking all adjacent vertices of %d...\n", curr);
for(int x = 0; x < V; x++)
{
if(adj[curr][x] == 1 && visited[x] == 0)
{
printf("Vertex %d is connected to Vertex %d\n", curr, x);
visited[x] = 1;
printf("Mark Vertex %d as VISITED\n", x);
q[rear++] = x;
printf("Insert Vertex %d into Queue\n", x);
}
}
printf("Current Queue : ");
if(front == rear)
{
printf("Empty");
}
else
{
for(int i = front; i < rear; i++)
printf("%d ", q[i]);
}
printf("\n");
}
}
int main()
{
int adj[V][V];
int res[V];
int resSize = 0;
printf("=========================================\n");
printf(" GRAPH TRAVERSAL USING BFS\n");
printf("=========================================\n");
printf("\nNumber of Vertices = %d\n", V);
printf("\nEnter the Adjacency Matrix (%d x %d)\n", V, V);
printf("Enter 1 if an edge exists, otherwise enter 0.\n\n");
// Read adjacency matrix
for(int i = 0; i < V; i++)
{
for(int j = 0; j < V; j++)
{
printf("Enter value for adj[%d][%d] : ", i, j);
scanf("%d", &adj[i][j]);
}
}
// Display adjacency matrix
printf("\nAdjacency Matrix Entered by the User\n");
printf("------------------------------------\n");
for(int i = 0; i < V; i++)
{
for(int j = 0; j < V; j++)
{
printf("%3d", adj[i][j]);
}
printf("\n");
}
// Call BFS
bfs(adj, res, &resSize);
// Display final traversal
printf("\n=========================================\n");
printf("Final BFS Traversal\n");
printf("=========================================\n");
for(int i = 0; i < resSize; i++)
{
printf("%d ", res[i]);
}
printf("\n");
return 0;
}
