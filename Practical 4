#include <stdio.h>
#define V 4
#define INF 99999
void printMatrix(int dist[][V])
{
int i, j;
for(i=0; i<V; i++)
{
for(j=0; j<V; j++)
{
if(dist[i][j]==INF)
printf("%7s","INF");
else
printf("%7d",dist[i][j]);
}
printf("\n");
}
}
void floydWarshall(int dist[][V])
{
int i,j,k;
printf("\n******** FLOYD WARSHALL ALGORITHM ********\n");
printf("\nInitial Distance Matrix:\n");
printMatrix(dist);
for(k=0;k<V;k++)
{
printf("\n=========================================\n");
printf("Using Vertex %d as Intermediate Vertex\n",k);
printf("=========================================\n");
for(i=0;i<V;i++)
{
for(j=0;j<V;j++)
{
if(dist[i][k]==INF || dist[k][j]==INF)
continue;
printf("\nChecking Path %d -> %d -> %d\n",i,k,j);
printf("Current Distance (%d -> %d) = ",i,j);
if(dist[i][j]==INF)
printf("INF\n");
else
printf("%d\n",dist[i][j]);
printf("Distance (%d -> %d) + (%d -> %d) = %d + %d = %d\n",
i,k,k,j,
dist[i][k],
dist[k][j],
dist[i][k]+dist[k][j]);
if(dist[i][k]+dist[k][j] < dist[i][j])
{
printf("Shorter path found.\n");
dist[i][j]=dist[i][k]+dist[k][j];
printf("Updated Distance (%d -> %d) = %d\n",
i,j,dist[i][j]);
}
else
{
printf("No Update Required.\n");
}
}
}
printf("\nDistance Matrix after considering Vertex %d\n",k);
printMatrix(dist);
}
printf("\n=========================================\n");
printf("Final Shortest Distance Matrix\n");
printf("=========================================\n");
printMatrix(dist);
}
int main()
{
int graph[V][V]=
{
{0,5,INF,10},
{INF,0,3,INF},
{INF,INF,0,1},
{INF,INF,INF,0}
};
printf("Input Graph (Adjacency Matrix)\n");
printMatrix(graph);
floydWarshall(graph);
return 0;
}
